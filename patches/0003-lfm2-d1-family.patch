--- /dev/null
+++ b/tensorfold/families/lfm2/cuda/model.py
@@ -0,0 +1,244 @@
+"""LFM2 on CUDA: the hybrid stack (short convolutions and GQA attention) over a tree of packed rows.
+
+A forward reads one trunk (the tokens every row shares) and N branches packed back to back on one axis,
+``[trunk | branch 0 | branch 1 | ...]``, and returns the final hidden state at each branch's last token.
+Token-wise work (norms, projections, the MLP) runs once over the packed axis; a convolution continues each
+branch from the trunk's last inputs; attention runs the trunk causally, every branch over the trunk in one
+flash call (the trunk's keys read once for all branches), and each branch over its own tokens in one varlen
+flash call, the two merged by their log-sum-exp. A decision needs only a handful of logits, so the 128k-row
+tied head is never applied: callers take the rows they need from ``logits``.
+
+The weights are the checkpoint's own bf16 tensors through cuBLAS, in the order `hybrid.py` (Liquid AI's d1
+runner) runs them: nothing is quantized at load and no precision is traded for speed.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+
+from . import fused
+
+Tensor = torch.Tensor
+
+# bytes one packed token's forward holds at once: the bf16 activations (residual stream copies, the merged q|k|v
+# and gate|up projections, the short convolution's projection and the silu output) and the two fp32 attention
+# outputs that the log-sum-exp merge reads. Admission and the graphs' pool bound share this figure.
+BF16_BYTES, FP32_BYTES = 2, 4
+
+
+def packed_token_bytes(hidden: int, ffn: int, heads: int, head_dim: int) -> int:
+    """Bytes one packed token's forward holds at once, from a config or a checkpoint's text config."""
+
+    return BF16_BYTES * (8 * hidden + 3 * hidden + 5 * ffn + hidden) + FP32_BYTES * 2 * heads * head_dim
+
+
+@dataclass
+class Config:
+    hidden: int
+    heads: int
+    kv_heads: int
+    head_dim: int
+    ffn: int
+    layers: list[str]
+    eps: float
+    theta: float
+    taps: int
+    vocab: int
+    vision: bool
+
+    @classmethod
+    def read(cls, model_dir: Path) -> "Config":
+        from .. import read_text_config
+
+        raw, t = read_text_config(model_dir)
+        hidden, heads = int(t["hidden_size"]), int(t["num_attention_heads"])
+        ffn = int(t["intermediate_size"])
+        if t.get("block_auto_adjust_ff_dim"):
+            ffn = int(2 * ffn / 3)
+            if t.get("block_ffn_dim_multiplier") is not None:
+                ffn = int(t["block_ffn_dim_multiplier"] * ffn)
+            m = int(t["block_multiple_of"])
+            ffn = m * ((ffn + m - 1) // m)
+        head_dim = int(t.get("head_dim") or hidden // heads)
+        rope = t.get("rope_parameters") or {"rope_theta": t.get("rope_theta", 1e6)}
+        return cls(hidden, heads, int(t["num_key_value_heads"]), head_dim, ffn, list(t["layer_types"]),
+                   float(t.get("norm_eps") or t.get("block_norm_eps")), float(rope["rope_theta"]),
+                   int(t["conv_L_cache"]), int(t["vocab_size"]), isinstance(raw.get("vision_config"), dict))
+
+
+class Tree:
+    """A trunk of ``p`` tokens and branches of ``lengths`` tokens, packed on one axis."""
+
+    def __init__(self, p: int, lengths: list[int], device, taps: int = 3):
+        """Indices are built on the host and moved in one copy, so building a tree never waits on the GPU."""
+
+        self.p, self.n = p, len(lengths)
+        ln = torch.tensor(lengths)
+        cu = F.pad(ln.cumsum(0), (1, 0))
+        self.longest = max(lengths)
+        branch = torch.repeat_interleave(torch.arange(self.n), ln)
+        positions = torch.cat((torch.arange(p), p + torch.arange(len(branch)) - cu[branch]))
+        leaves = p + cu[1:] - 1
+        # each token's predecessors 1..taps-1 back in its own sequence: the branch, then the trunk (-1: before it)
+        index = torch.arange(len(positions))[:, None]
+        back = positions[:, None] - torch.arange(1, taps)
+        prev = torch.where(back < 0, -1, torch.where(back >= p, index - torch.arange(1, taps), back))
+        host = torch.cat((cu, positions, leaves, prev.reshape(-1))).pin_memory()
+        dev = host.to(device, non_blocking=True)
+        a, b = self.n + 1, self.n + 1 + len(positions)
+        self.cu = dev[:a].int()
+        self.positions, self.leaves = dev[a:b], dev[b:b + self.n]
+        self.prev = dev[b + self.n:].view(len(positions), taps - 1)
+
+
+def _merge(oa: Tensor, la: Tensor, ob: Tensor, lb: Tensor) -> Tensor:
+    m = torch.maximum(la, lb)
+    wa, wb = (la - m).exp(), (lb - m).exp()
+    return (oa * wa[..., None] + ob * wb[..., None]) / (wa + wb)[..., None]
+
+
+def attention(q: Tensor, k: Tensor, v: Tensor, tree: Tree, scale: float) -> Tensor:
+    """``q`` ``(H, T, D)``, ``k``/``v`` ``(KV, T, D)`` over a tree -> ``(H, T, D)``."""
+
+    p = tree.p
+    heads, kv = q.shape[0], k.shape[0]
+    qb, kb, vb = q[:, p:], k[:, p:], v[:, p:]
+    # each branch over its own tokens (varlen, causal); GQA is handled by the kernel
+    own, own_lse = torch.ops.aten._flash_attention_forward(
+        qb.transpose(0, 1), kb.transpose(0, 1), vb.transpose(0, 1), tree.cu, tree.cu, tree.longest, tree.longest,
+        0.0, True, False, scale=scale)[:2]
+    own = own.transpose(0, 1).float()
+    if p == 0:
+        return own.to(q.dtype)
+    trunk = F.scaled_dot_product_attention(q[None, :, :p], k[None, :, :p], v[None, :, :p], is_causal=True,
+                                           scale=scale, enable_gqa=True)[0]
+    # every branch token over the whole trunk: each KV head's query group folded into the query axis
+    length = qb.shape[1]
+    folded = qb.reshape(1, kv, heads // kv * length, q.shape[-1])
+    seen, seen_lse = torch.ops.aten._scaled_dot_product_flash_attention(
+        folded, k[None, :, :p], v[None, :, :p], 0.0, False, False, scale=scale)[:2]
+    seen = seen.reshape(heads, length, q.shape[-1]).float()
+    seen_lse = seen_lse.reshape(heads, length)
+    return torch.cat((trunk, _merge(seen, seen_lse, own, own_lse).to(q.dtype)), dim=1)
+
+
+@dataclass
+class Layer:
+    kind: str
+    op_norm: Tensor
+    ffn_norm: Tensor
+    up: Tensor            # the MLP gate and up, merged: [2 ffn, hidden]
+    down: Tensor
+    proj: Tensor          # conv: in_proj [3 hidden, hidden]; attention: q|k|v merged
+    out: Tensor
+    conv: Tensor | None = None            # (C, 1, taps)
+    q_norm: Tensor | None = None
+    k_norm: Tensor | None = None
+
+
+@dataclass
+class Model:
+    cfg: Config
+    embed: Tensor                          # bf16 [vocab, hidden], also the tied head
+    norm: Tensor
+    layers: list[Layer] = field(default_factory=list)
+
+    @classmethod
+    def load(cls, model_dir: Path, device: str = "cuda") -> "Model":
+        """The checkpoint's bf16 language weights, moved to the GPU; refused unless the config reads and every
+        tensor the kernels need is present."""
+
+        from safetensors import safe_open
+
+        cfg = Config.read(model_dir)
+        files = sorted(model_dir.glob("*.safetensors"))
+        split = [path.name for path in files if ".rank" in path.name]
+        if split:
+            raise ValueError(f"this checkpoint holds another rank's split weights ({split[0]}); use the complete "
+                             "checkpoint folder")
+        tensors: dict[str, Tensor] = {}
+        for path in files:
+            with safe_open(str(path), "pt", device="cpu") as f:
+                for key in f.keys():
+                    if key.startswith(("model.language_model.", "model.layers.", "model.embed", "model.embedding")):
+                        tensors[key] = f.get_tensor(key)
+        if not tensors:
+            raise ValueError(f"no language-model tensors in {model_dir} (a complete d1 checkpoint is needed)")
+        pre = "model.language_model." if any(k.startswith("model.language_model.") for k in tensors) else "model."
+
+        def take(name: str) -> Tensor:
+            found = tensors.pop(pre + name, None)
+            if found is None:
+                raise ValueError(f"the checkpoint has no {pre}{name}, which an LFM2 forward needs")
+            if found.dtype != torch.bfloat16:      # a stored format the LFM2 kernels do not read, not a cast
+                raise ValueError(f"{pre}{name} is stored as {found.dtype}, and LFM2 d1 reads bf16 weights")
+            return found.to(device=device)
+
+        model = cls(cfg, take("embed_tokens.weight"), take("embedding_norm.weight"))
+        for i, kind in enumerate(cfg.layers):
+            base = f"layers.{i}."
+            op_norm, ffn_norm = take(base + "operator_norm.weight"), take(base + "ffn_norm.weight")
+            # the MLP's gate (w1) and up (w3) projections are one matrix: the fused SwiGLU reads them together
+            up = torch.cat((take(base + "feed_forward.w1.weight"), take(base + "feed_forward.w3.weight")))
+            down = take(base + "feed_forward.w2.weight")
+            if kind == "conv":
+                model.layers.append(Layer(kind, op_norm, ffn_norm, up, down, take(base + "conv.in_proj.weight"),
+                                          take(base + "conv.out_proj.weight"), conv=take(base + "conv.conv.weight")))
+            else:
+                qkv = torch.cat((take(base + "self_attn.q_proj.weight"), take(base + "self_attn.k_proj.weight"),
+                                 take(base + "self_attn.v_proj.weight")))
+                model.layers.append(Layer(kind, op_norm, ffn_norm, up, down, qkv,
+                                          take(base + "self_attn.out_proj.weight"),
+                                          q_norm=take(base + "self_attn.q_layernorm.weight"),
+                                          k_norm=take(base + "self_attn.k_layernorm.weight")))
+        if tensors:
+            raise ValueError(f"{len(tensors)} language tensor(s) the LFM2 kernels do not read: "
+                             f"{', '.join(sorted(tensors)[:4])}")
+        torch.cuda.empty_cache()
+        return model
+
+    def _cos_sin(self, positions: Tensor) -> tuple[Tensor, Tensor]:
+        """fp32 ``(T, head_dim)`` cos and sin of half-split RoPE."""
+
+        d = self.cfg.head_dim
+        inv = 1.0 / self.cfg.theta ** (torch.arange(0, d, 2, device=positions.device).float() / d)
+        ang = positions.float()[:, None] * inv
+        ang = torch.cat((ang, ang), dim=-1)
+        return ang.cos(), ang.sin()
+
+    @torch.inference_mode()
+    def forward(self, embeds: Tensor, tree: Tree) -> Tensor:
+        """``embeds`` ``(T, hidden)`` over ``tree`` -> final hidden states at each branch's last token ``(N, hidden)``."""
+
+        c = self.cfg
+        cos, sin = self._cos_sin(tree.positions)
+        scale = c.head_dim ** -0.5
+        hq, hk = c.heads * c.head_dim, c.kv_heads * c.head_dim
+        h, x = fused.add_rms(embeds, None, self.layers[0].op_norm, c.eps)
+        for i, layer in enumerate(self.layers):
+            if layer.kind == "conv":
+                y = F.linear(fused.short_conv(F.linear(x, layer.proj), layer.conv, tree.prev), layer.out)
+            else:
+                qkv = F.linear(x, layer.proj)
+                q, k = fused.qk_norm_rope(qkv, layer.q_norm, layer.k_norm, cos, sin, c.heads, c.kv_heads,
+                                          c.head_dim, c.eps)
+                v = qkv[:, hq + hk:].view(-1, c.kv_heads, c.head_dim)
+                a = attention(q.transpose(0, 1), k.transpose(0, 1), v.transpose(0, 1).contiguous(), tree, scale)
+                y = F.linear(a.transpose(0, 1).reshape(-1, hq).contiguous(), layer.out)
+            h, x = fused.add_rms(h, y, layer.ffn_norm, c.eps)
+            d = F.linear(fused.silu_mul(F.linear(x, layer.up)), layer.down)
+            if i + 1 < len(self.layers):
+                h, x = fused.add_rms(h, d, self.layers[i + 1].op_norm, c.eps)
+        return fused.add_rms(h[tree.leaves], d[tree.leaves], self.norm, c.eps)[1]
+
+    def logits(self, hidden: Tensor, ids: Tensor) -> Tensor:
+        """fp32 logits of ``ids`` at each row of ``hidden``: the head's rows for those tokens only."""
+
+        return hidden.float() @ self.embed[ids].float().t()
+
+    def embed_ids(self, ids: list[int]) -> Tensor:
+        return self.embed[torch.tensor(ids, device=self.embed.device)]
diff --git a/tensorfold/families/lfm2/cuda/vision.py b/tensorfold/families/lfm2/cuda/vision.py
--- /dev/null
+++ b/tensorfold/families/lfm2/cuda/vision.py
@@ -0,0 +1,110 @@
+"""LFM2-VL pictures: the checkpoint's SigLIP2 NaFlex tower and projector (transformers' modules, bf16), and the
+processor that tiles a picture and writes its placeholder tokens. A picture's features replace its placeholder
+tokens' embeddings in the trunk; everything after that is the language model's tree forward."""
+
+from __future__ import annotations
+
+import json
+import math
+from pathlib import Path
+
+import torch
+
+MAX_PIXELS = 1024 * 1024           # every picture is bounded at this many pixels first (bicubic)
+
+
+def _cap(image):
+    w, h = image.size
+    if w * h <= MAX_PIXELS:
+        return image
+    from PIL import Image
+
+    s = math.sqrt(MAX_PIXELS / (w * h))
+    return image.resize((max(1, int(w * s)), max(1, int(h * s))), Image.Resampling.BICUBIC)
+
+
+class Vision:
+    def __init__(self, processor, tower, projector, image_token: int, device: str):
+        self.processor, self.tower, self.projector = processor, tower, projector
+        self.image_token, self.device = image_token, device
+        self._markup: dict[int, str] = {}
+
+    @classmethod
+    def load(cls, model_dir: Path, device: str = "cuda") -> "Vision":
+        from safetensors import safe_open
+        from transformers import AutoProcessor, Lfm2VlConfig
+        from transformers.models.lfm2_vl.modeling_lfm2_vl import Lfm2VlMultiModalProjector
+        from transformers.models.siglip2.modeling_siglip2 import Siglip2VisionModel
+
+        raw = json.loads((model_dir / "config.json").read_text())
+        if "vision_config" not in raw:
+            raise FileNotFoundError("no vision tower in this checkpoint")
+        cfg = Lfm2VlConfig(**{k: v for k, v in raw.items() if k not in ("auto_map", "architectures")})
+        tower = Siglip2VisionModel(cfg.vision_config).to(torch.bfloat16)
+        projector = Lfm2VlMultiModalProjector(cfg).to(torch.bfloat16)
+        state_t, state_p = {}, {}
+        for path in sorted(model_dir.glob("*.safetensors")):
+            with safe_open(str(path), "pt", device="cpu") as f:
+                for key in f.keys():
+                    if key.startswith("model.vision_tower."):
+                        state_t[key[len("model.vision_tower."):]] = f.get_tensor(key)
+                    elif key.startswith("model.multi_modal_projector."):
+                        state_p[key[len("model.multi_modal_projector."):]] = f.get_tensor(key)
+        wanted = set(tower.state_dict())
+        strange = [(key, value.dtype) for key, value in (*state_t.items(), *state_p.items())
+                   if value.dtype != torch.bfloat16]
+        if strange:
+            raise ValueError(f"{strange[0][0]} is stored as {strange[0][1]}, and the LFM2-VL tower reads bf16 weights")
+        if not state_t:
+            raise ValueError(f"no vision tower tensors in {model_dir}, which its config's vision_config needs")
+        if not any(k in wanted for k in state_t):          # transformers releases differ in the wrapper prefix
+            state_t = {k.split("vision_model.", 1)[-1] if k.startswith("vision_model.") else f"vision_model.{k}": v
+                       for k, v in state_t.items()}
+        missing = tower.load_state_dict(state_t, strict=False)
+        if missing.missing_keys:
+            raise ValueError(f"vision tower weights missing: {missing.missing_keys[:4]}")
+        projector.load_state_dict(state_p)
+        tower.to(device).eval()
+        projector.to(device).eval()
+        processor = AutoProcessor.from_pretrained(str(model_dir))
+        return cls(processor, tower, projector, int(cfg.image_token_id), device)
+
+    def markup(self, n: int) -> str:
+        """What the chat template writes for ``n`` pictures at the head of a user turn."""
+
+        if n not in self._markup:
+            msgs = [{"role": "user", "content": [*([{"type": "image"}] * n), {"type": "text", "text": "\x00"}]}]
+            text = self.processor.apply_chat_template(msgs, add_generation_prompt=False, tokenize=False)
+            head = "<|im_start|>user\n"
+            self._markup[n] = text[text.index(head) + len(head):text.index("\x00")]
+        return self._markup[n]
+
+    @torch.inference_mode()
+    def trunk(self, model, fmt, state, images) -> tuple[list[int], torch.Tensor]:
+        """Token ids of the state's prefix with the pictures expanded (the questions' suffixes follow it as
+        branches), and their embeddings with the pictures' features in their placeholder slots."""
+
+        pics = [_cap(im) for im in images]
+        text = fmt.prefix(state, self.markup(len(pics)))
+        inputs = self.processor(text=[text], images=[pics], return_tensors="pt", add_special_tokens=False)
+        ids = inputs["input_ids"][0]
+        pv, mask = inputs["pixel_values"], inputs["pixel_attention_mask"]
+        n = int(mask.sum(1).max())           # every picture is padded to the patch budget; the tower masks it
+        pv, mask = pv[:, :n], mask[:, :n]
+        out = self.tower(pixel_values=pv.to(self.device, torch.bfloat16),
+                         spatial_shapes=inputs["spatial_shapes"].to(self.device),
+                         pixel_attention_mask=mask.to(self.device), return_dict=True).last_hidden_state
+        lengths = mask.sum(dim=1)
+        feats = []
+        for i in range(out.shape[0]):
+            h, w = (int(v) for v in inputs["spatial_shapes"][i])
+            f = out[i, : int(lengths[i])].reshape(1, h, w, -1)
+            feats.append(self.projector(f).reshape(-1, self.projector.linear_2.out_features))
+        features = torch.cat(feats).to(torch.bfloat16)
+        ids_dev = ids.to(model.embed.device)
+        embeds = model.embed[ids_dev].clone()
+        slots = ids_dev == self.image_token
+        if int(slots.sum()) != features.shape[0]:
+            raise ValueError(f"{int(slots.sum())} picture slots for {features.shape[0]} picture features")
+        embeds[slots] = features
+        return ids.tolist(), embeds
diff --git a/tensorfold/families/lfm2/decisions.py b/tensorfold/families/lfm2/decisions.py
--- /dev/null
+++ b/tensorfold/families/lfm2/decisions.py
@@ -0,0 +1,182 @@
+"""The d1 decision format: a state and typed questions in, one forward per request, answers read from the
+logits at the answer slot.
+
+Questions follow the Decision Index schema (``type``, ``instructions``, ``criteria``): ``noul`` (yes/no, the
+answer is P(yes)), ``choice`` (one of named options) and ``score`` (2 to 10 ordered levels, the answer is the
+expected level). The prompt pieces are the ones llama-server renders from the checkpoint's own
+``tokenizer.chat_template.systemone``, which is d1's ``prompt.py`` in a template; each option is scored by the
+best logit among its single-token forms; the answer is a softmax over the options only, so the vocabulary's
+log-sum-exp never matters and only those rows of the head are read.
+"""
+
+from __future__ import annotations
+
+import json
+import math
+from dataclasses import dataclass
+from functools import lru_cache
+from typing import Any
+
+from tensorfold.server.decisions import DecisionError as _ServerDecisionError
+
+IM_START, IM_END, BOS = "<|im_start|>", "<|im_end|>", "<|startoftext|>"
+YES, NO = ("yes", "Yes", "YES"), ("no", "No", "NO")
+
+
+class DecisionError(_ServerDecisionError):
+    """A request the decision format cannot express (HTTP 400)."""
+
+
+@dataclass(frozen=True)
+class Question:
+    kind: str                         # noul | choice | score
+    instructions: str
+    keys: tuple[str, ...] = ()        # choice: option names; score: level texts; noul: () or ("true","false")
+    texts: tuple[Any, ...] = ()       # choice: descriptions (or None); noul: the true/false descriptions
+
+
+def _text(v: Any) -> str:
+    return v if isinstance(v, str) else json.dumps(v, ensure_ascii=False)
+
+
+def question(raw: Any) -> Question:
+    if not isinstance(raw, dict):
+        raise DecisionError("a question is an object with type, instructions and criteria")
+    kind = raw.get("type", "choice")
+    if raw.get("instructions") is None:
+        raise DecisionError("a question needs instructions (llama-server's System One requires them)")
+    instr = _text(raw["instructions"])
+    crit = raw.get("criteria")
+    if kind == "noul":
+        if crit is None:
+            return Question("noul", instr)
+        if not isinstance(crit, dict):
+            raise DecisionError("noul criteria is an object with true and false")
+        return Question("noul", instr, ("true", "false"), (crit.get("true"), crit.get("false")))
+    if kind == "score":
+        if not isinstance(crit, list) or not 2 <= len(crit) <= 10:
+            raise DecisionError("score criteria is a list of 2 to 10 levels, lowest first")
+        return Question("score", instr, tuple(_text(c) for c in crit))
+    if kind == "choice":
+        if not isinstance(crit, dict) or not crit:
+            raise DecisionError("choice criteria is a non-empty object of option: description")
+        return Question("choice", instr, tuple(str(k) for k in crit), tuple(crit.values()))
+    raise DecisionError(f"unknown question type {kind!r}: choose noul, choice or score")
+
+
+class Format:
+    """Prompt pieces and readout tokens for one tokenizer (``tokenizers.Tokenizer``)."""
+
+    def __init__(self, tok):
+        self.tok = tok
+        self._one = lru_cache(maxsize=65536)(self._one_token)
+
+    def encode(self, text: str) -> list[int]:
+        return self.tok.encode(text, add_special_tokens=False).ids
+
+    def _one_token(self, text: str) -> int | None:
+        ids = self.encode(text)
+        return ids[0] if len(ids) == 1 else None
+
+    # ------------------------------------------------------------------ option codes
+
+    def codes(self, keys: tuple[str, ...]) -> list[tuple[str, int]]:
+        """A distinct single-token code per option: the keys when they are single letters, else A, B, ... (00, 01,
+        ... past 26), each replaced by the next free single-token code when it is not one token."""
+
+        keys = tuple(k.strip() for k in keys)
+        if keys and all(len(k) == 1 and k.isalpha() for k in keys):
+            wanted = list(keys)
+        elif len(keys) <= 26:
+            wanted = [chr(65 + i) for i in range(len(keys))]
+        else:
+            wanted = [f"{i:02d}" for i in range(len(keys))]
+        pool = ([chr(c) for c in range(65, 91)] + [f"{i:02d}" for i in range(100)] + [chr(c) for c in range(97, 123)]
+                + [f"#{i}" for i in range(200)] + [chr(a) + chr(b) for a in range(65, 91) for b in range(65, 91)])
+        used: set[int] = set()
+        out = []
+        for code in wanted:
+            for candidate in (code, *pool):
+                tid = self._one(candidate)
+                if tid is not None and tid not in used:
+                    used.add(tid)
+                    out.append((candidate, tid))
+                    break
+            else:
+                raise DecisionError(f"no single-token code left for {len(keys)} options")
+        return out
+
+    def readout(self, q: Question) -> list[list[int]]:
+        """Token ids per option; an option scores its best form. A question whose tokenizer has none of an
+        option's single-token forms cannot be read at the answer slot and is refused here."""
+
+        def forms(texts) -> list[int]:
+            seen: list[int] = []
+            for t in texts:
+                tid = self._one(t)
+                if tid is not None and tid not in seen:
+                    seen.append(tid)
+            return seen
+
+        if q.kind == "noul":
+            groups = [forms(YES), forms(NO)]
+            if not all(groups):
+                raise DecisionError("this tokenizer has no single-token yes/no, which a noul question is read at")
+            return groups
+        if q.kind == "score":
+            groups = [forms((str(i),)) for i in range(len(q.keys))]
+            if any(not g for g in groups):
+                raise DecisionError(f"a score with {len(q.keys)} levels needs single-token digits")
+            return groups
+        groups = []
+        for code, tid in self.codes(q.keys):
+            extra = self._one(" " + code)
+            groups.append([tid] + ([extra] if extra is not None and extra != tid else []))
+        return groups
+
+    # ------------------------------------------------------------------ prompt
+
+    @staticmethod
+    def state_block(state: Any) -> str:
+        if isinstance(state, str):
+            return state + "\n\n"
+        return json.dumps(state, ensure_ascii=False, indent=2) + "\n\n"
+
+    def prefix(self, state: Any, images: str = "") -> str:
+        body = "" if state is None else self.state_block(state) + "\nQUESTION:\n"
+        return f"{BOS}{IM_START}user\n{images}{body}"
+
+    def question_text(self, q: Question) -> str:
+        if q.kind == "choice":
+            lines = []
+            for (code, _), key, desc in zip(self.codes(q.keys), q.keys, q.texts):
+                # a description is shown as written (JSON for anything that is not text); without one, the name
+                lines.append(f"{code} {_text(desc) if desc else key.replace('_', ' ')}")
+            return f"{q.instructions}\n\nOptions:\n" + "\n".join(lines) + "\n\nReply with the option code only."
+        if q.kind == "noul":
+            # the systemone template shows nothing unless one of the two sides has a description, then both
+            shown = [text if text is not None else "None" for text in q.texts]
+            extra = "".join(f"\n{name}: {_text(text)}" for name, text in zip(("Yes", "No"), shown)) \
+                if any(text is not None for text in q.texts) else ""
+            return f"{q.instructions}{extra}\n\nReply with yes or no only."
+        legend = "\n".join(f"{i} {name}" for i, name in enumerate(q.keys))
+        return f"{q.instructions}\n\n{legend}\n\nReply with a single digit 0-{len(q.keys) - 1} only."
+
+    def suffix(self, q: Question) -> str:
+        return f"{self.question_text(q)}{IM_END}\n{IM_START}assistant\n"
+
+
+def answer(q: Question, scores: list[float]) -> dict[str, Any]:
+    m = max(scores)
+    e = [math.exp(s - m) for s in scores]
+    z = sum(e)
+    p = [x / z for x in e]
+    if q.kind == "noul":
+        return {"type": "noul", "noul": p[0]}
+    best = max(range(len(p)), key=p.__getitem__)
+    if q.kind == "choice":
+        return {"type": "choice", "choice": q.keys[best], "confidence": p[best],
+                "probabilities": dict(zip(q.keys, p))}
+    return {"type": "score", "score": sum(i * x for i, x in enumerate(p)), "confidence": p[best],
+            "probabilities": {str(i): x for i, x in enumerate(p)},
+            "legend": {str(i): t for i, t in enumerate(q.keys)}}
