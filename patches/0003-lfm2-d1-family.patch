+++ b/tensorfold/families/lfm2/cuda/linear.py
@@ -0,0 +1,159 @@
+"""The projections of the LFM2 engine in one of three precisions.
+
+``bf16``  the checkpoint's own weights through cuBLAS.
+``fp8``   W8A16: e4m3 weights with an fp32 scale per (row, 64 inputs), bf16 activations. Few rows run on TensorFold's
+          exact-weight FP8 lane matmul (the weight bytes are the cost); many rows run the same weights, dequantized
+          once to bf16, through cuBLAS (the math is the cost there). Both read the same weight values.
+``int4``  W4A16 affine integers, a bf16 scale and bias per 32 inputs (MLX's 4-bit layout), on TensorFold's 4-bit
+          lane matmul (the one it serves MLX checkpoints with): 5 bits a weight. Each group's scale and bias come
+          from a weighted least-squares search over candidate ranges, as llama.cpp's k-quants choose theirs.
+Quantized copies are made from the bf16 checkpoint at load, so no extra download is needed.
+"""
+
+from __future__ import annotations
+
+import torch
+import torch.nn.functional as F
+
+PRECISIONS = ("bf16", "fp8", "int4")
+# int4: groups of 32 with the weighted search, on d1-3B's parity set close to llama.cpp's Q4_K_M (groups of 64 are
+# faster on sm_12x's grouped kernel but lose about twice the probability: median |dp| 0.028 vs 0.016)
+INT4_GROUP, INT4_STEPS = 32, 20
+# at or above this many rows a quantized projection runs its bf16 copy through cuBLAS
+DENSE_ROWS = 256
+
+
+class Bf16:
+    def __init__(self, w: torch.Tensor):
+        self.w = w.contiguous()
+
+    def __call__(self, x: torch.Tensor) -> torch.Tensor:
+        return F.linear(x, self.w)
+
+    def nbytes(self) -> int:
+        return self.w.numel() * 2
+
+
+class Quantized:
+    """A TensorFold FP8 or 4-bit lane-matmul linear, with the same values in bf16 for wide prompts."""
+
+    def __init__(self, inner, dense: torch.Tensor):
+        self.inner, self.dense = inner, dense
+
+    def __call__(self, x: torch.Tensor) -> torch.Tensor:
+        if x.shape[0] >= DENSE_ROWS:
+            return F.linear(x, self.dense)
+        return self.inner(x)
+
+    def nbytes(self) -> int:
+        """Bytes a few-row forward reads (the quantized weights)."""
+        return self.inner.nbytes()
+
+
+def fp8(w: torch.Tensor) -> Quantized:
+    """W8A16 with an fp32 scale per (row, 64 inputs): TensorFold's block FP8 (FP8G) lane matmul."""
+
+    from tensorfold.cuda.nvfp4.linear import Fp8BlockLinear
+
+    n, k = w.shape
+    w32 = w.float().view(n, k // 64, 64)
+    scale = (w32.abs().amax(-1) / 448.0).clamp(min=1e-12)           # [n, k/64]
+    codes = (w32 / scale[..., None]).clamp(-448, 448).to(torch.float8_e4m3fn)
+    dense = (codes.float() * scale[..., None]).view(n, k).to(torch.bfloat16)
+    return Quantized(Fp8BlockLinear.from_rows(codes.view(n, k), scale.contiguous()), dense)
+
+
+def _affine_params(g: torch.Tensor, top: int, steps: int = 20) -> tuple[torch.Tensor, torch.Tensor]:
+    """bf16 (scale, bias) per row of ``g`` [G, gs] minimizing the weighted error of ``scale * q + bias``.
+
+    Candidate ranges stretch and shrink the min..max step (``rmin + rdelta * i``, llama.cpp's make_qkx2_quants);
+    for each, the levels are fixed and the scale and bias solved by weighted least squares, then rounded to bf16
+    as they are stored. Weights ``|x| + rms(x)`` favor the large inputs, as k-quants do without an imatrix.
+    """
+
+    lo, hi = g.amin(-1, keepdim=True), g.amax(-1, keepdim=True)
+    span = (hi - lo).clamp(min=1e-12)
+    wt = g.abs() + g.pow(2).mean(-1, keepdim=True).sqrt()
+    sw = wt.sum(-1, keepdim=True)
+    swx = (wt * g).sum(-1, keepdim=True)
+
+    def error(scale, bias):
+        q = ((g - bias) / scale).round().clamp(0, top)
+        return (wt * (q * scale + bias - g).pow(2)).sum(-1, keepdim=True)
+
+    best_s = (span / top).to(torch.bfloat16).float()
+    best_b = lo.to(torch.bfloat16).float()
+    best_e = error(best_s, best_b)
+    for i in range(steps + 1):
+        q = ((g - lo) * ((top - 1.0 + 0.1 * i) / span)).round().clamp(0, top)
+        swq, swq2, swqx = (wt * q).sum(-1, keepdim=True), (wt * q * q).sum(-1, keepdim=True), \
+            (wt * q * g).sum(-1, keepdim=True)
+        det = sw * swq2 - swq * swq
+        ok = det > 0
+        safe = torch.where(ok, det, torch.ones_like(det))
+        s = ((sw * swqx - swq * swx) / safe).clamp(min=1e-12).to(torch.bfloat16).float()
+        b = ((swq2 * swx - swq * swqx) / safe).to(torch.bfloat16).float()
+        e = torch.where(ok, error(s, b), torch.full_like(best_e, float("inf")))
+        better = e < best_e
+        best_s, best_b, best_e = torch.where(better, s, best_s), torch.where(better, b, best_b), \
+            torch.where(better, e, best_e)
+    return best_s, best_b
+
+
+def _affine(w: torch.Tensor, bits: int, gs: int, rows: int = 2048):
+    """MLX affine quantization of a bf16 weight: (int32 words, bf16 scales, bf16 biases, bf16 dequantized copy)."""
+
+    n, k = w.shape
+    top = (1 << bits) - 1
+    scales = torch.empty((n, k // gs), dtype=torch.bfloat16, device=w.device)
+    biases = torch.empty_like(scales)
+    q = torch.empty((n, k // gs, gs), dtype=torch.int64, device=w.device)
+    dense = torch.empty((n, k), dtype=torch.bfloat16, device=w.device)
+    for r in range(0, n, rows):                                 # in row chunks: the search keeps a few fp32 copies
+        g = w[r:r + rows].float().view(-1, k // gs, gs)
+        s, b = _affine_params(g.reshape(-1, gs), top, INT4_STEPS)
+        s, b = s.view(-1, k // gs, 1), b.view(-1, k // gs, 1)
+        qr = ((g - b) / s).round().clamp(0, top)
+        scales[r:r + rows], biases[r:r + rows] = s[..., 0].to(torch.bfloat16), b[..., 0].to(torch.bfloat16)
+        q[r:r + rows] = qr.to(torch.int64)
+        dense[r:r + rows] = (qr * s + b).view(-1, k).to(torch.bfloat16)
+    per = 32 // bits
+    q = q.view(n, k // per, per)
+    words = torch.zeros((n, k // per), dtype=torch.int64, device=w.device)
+    for j in range(per):                                        # little-endian slots, MLX's packing
+        words |= q[..., j] << (bits * j)
+    words = torch.where(words >= 1 << 31, words - (1 << 32), words).to(torch.int32)
+    return words.contiguous(), scales.contiguous(), biases.contiguous(), dense
+
+
+class _Q4:
+    def __init__(self, q):
+        from tensorfold.cuda.kernels import qmm
+
+        self.q, self._mm = q, qmm.matmul
+
+    def __call__(self, x):
+        return self._mm(x.contiguous(), self.q)
+
+    def nbytes(self) -> int:
+        return sum(t.numel() * t.element_size() for t in (self.q.weight, self.q.scales, self.q.biases))
+
+
+def int4(w: torch.Tensor) -> Quantized:
+    from tensorfold.cuda.kernels import qmm
+
+    words, scales, biases, dense = _affine(w, 4, INT4_GROUP)
+    return Quantized(_Q4(qmm.pack(words, scales, biases, INT4_GROUP)), dense)
+
+
+def make(w: torch.Tensor, precision: str):
+    if precision == "bf16":
+        return Bf16(w)
+    if precision == "int4":
+        return int4(w)
+    if precision == "fp8":
+        return fp8(w)
+    raise ValueError(f"precision {precision!r}: choose one of {', '.join(PRECISIONS)}")
+
+
+Linear = Bf16 | Quantized
