@@ -0,0 +1,228 @@
+"""Exact-shape CUDA graphs for d1 decisions: one graph a tree geometry, fed the eager path's own inputs.
+
+A tree's geometry (the trunk's length and every branch's length) fixes every shape, index tensor and kernel launch
+of a forward, so a graph captured for one geometry replays the eager path's arithmetic exactly: the same kernels
+over the same shapes, with the packed embeddings copied into the graph's own input buffer before every replay.
+Nothing is padded and no row is added, so a replayed decision reads the bits its own forward reads, and a shape
+with no graph runs the eager path unchanged.
+
+A geometry is captured only once it has been asked for :data:`PROMOTE` times, so a first or one-off shape never
+pays for a capture it will not use. The graphs that are kept stay inside :data:`LIMIT` entries and :data:`BUDGET`
+bytes of captured pool, input and output (the startup admission reserves that budget); the room a new shape needs
+comes from the least recently used graph that has replayed fewer times than the new shape has been seen, so a
+graph that has proved its use is never churned out by a shape nobody has asked for again — a working set bigger
+than the cache simply runs eagerly. Every method that touches a buffer runs under ``no_grad``, like the
+``Model.forward`` it captures, and replay fires on the caller's stream, so a graphed decision has the eager
+path's mode and ordering.
+"""
+
+from __future__ import annotations
+
+import gc
+
+import torch
+
+from .model import BF16_BYTES, Tree, packed_token_bytes
+
+# sightings before a geometry is captured (the first runs eagerly, so a one-off shape is never captured)
+PROMOTE = 2
+# resident graphs, and the bytes their captured pools, inputs and outputs together may hold
+LIMIT = 8
+BUDGET = 2 * 1024**3
+# geometries whose sightings are counted; past it the oldest are forgotten and their count starts over
+REMEMBER = 4096
+
+
+class Roster:
+    """Which tree geometries hold a graph, and which give way: the promotion, the budget and the LRU order.
+
+    No CUDA here: the promotion, the byte budget, the LRU order and the eviction rule are plain Python, so they
+    are tested without a GPU.
+    """
+
+    def __init__(self, budget: int = BUDGET, limit: int = LIMIT, promote: int = PROMOTE,
+                 remember: int = REMEMBER) -> None:
+        self.budget, self.limit, self.promote = int(budget), int(limit), int(promote)
+        self.remember = int(remember)
+        self.sizes: dict[tuple, int] = {}          # resident geometry -> bytes it reserves
+        self.heat: dict[tuple, int] = {}           # every geometry -> its sightings
+        self.benefit: dict[tuple, int] = {}        # resident geometry -> its replays
+        self.order: list[tuple] = []               # resident geometries, least recently used first
+        self.used = 0
+        self.captures = self.replays = self.eager = self.evictions = 0
+
+    def resident(self, key: tuple) -> bool:
+        return key in self.sizes
+
+    def fits(self, cost: int) -> bool:
+        """A geometry that cannot fill the budget by itself is never captured (its forward stays eager)."""
+
+        return int(cost) <= self.budget
+
+    def note(self, key: tuple) -> int:
+        """Count a sighting and return the geometry's heat; only ``remember`` geometries are tracked."""
+
+        self.heat[key] = self.heat.get(key, 0) + 1
+        while len(self.heat) > self.remember:      # dicts keep insertion order, so this drops the oldest geometry
+            self.heat.pop(next(iter(self.heat)))
+        return self.heat[key]
+
+    def wanted(self, key: tuple) -> bool:
+        """Whether this sighting is the one that captures: the promotion count is reached and no graph is kept."""
+
+        return key not in self.sizes and self.heat.get(key, 0) >= self.promote
+
+    def room_for(self, cost: int, heat: int) -> list[tuple] | None:
+        """The graphs a shape this hot may take the place of, or ``None`` when it cannot have room.
+
+        The least recently used graph goes first, and only while it has replayed fewer times than this shape has
+        been seen: a graph that is earning its keep is not evicted for a shape nobody has asked for again.
+        """
+
+        gone, used, order = [], self.used, list(self.order)
+        while order and (used + int(cost) > self.budget or len(order) >= self.limit):
+            victim = order[0]
+            if self.benefit.get(victim, 0) >= heat:
+                return None
+            order.pop(0)
+            gone.append(victim)
+            used -= self.sizes[victim]
+        return gone
+
+    def admit(self, key: tuple, cost: int) -> None:
+        """Record a geometry that now holds a graph (its room was made by ``room_for``)."""
+
+        self.sizes[key] = int(cost)
+        self.benefit[key] = 0
+        self.used += int(cost)
+        self.order.append(key)
+
+    def replay(self, key: tuple) -> None:
+        """A graph replayed: its benefit and the run's replay count."""
+
+        self.benefit[key] = self.benefit.get(key, 0) + 1
+        self.replays += 1
+        self.touch(key)
+
+    def touch(self, key: tuple) -> None:
+        if key in self.sizes:
+            self.order.remove(key)
+            self.order.append(key)
+
+    def drop(self, key: tuple) -> tuple:
+        """An evicted geometry: its heat starts over, so a capture needs :data:`PROMOTE` fresh sightings again."""
+
+        self.used -= self.sizes.pop(key)
+        self.benefit.pop(key, None)
+        self.heat.pop(key, None)
+        self.order.remove(key)
+        self.evictions += 1
+        return key
+
+    def stats(self) -> dict:
+        return {"resident": len(self.sizes), "bytes": self.used, "budget_bytes": self.budget, "limit": self.limit,
+                "promote": self.promote, "captures": self.captures, "replays": self.replays,
+                "eager": self.eager, "evictions": self.evictions}
+
+
+class Graphs:
+    """The resident graphs and their buffers, keyed by a tree's geometry (its trunk and branch lengths)."""
+
+    def __init__(self, model, *, budget: int = BUDGET, limit: int = LIMIT, promote: int = PROMOTE) -> None:
+        self.model = model
+        self.roster = Roster(budget, limit, promote)
+        self.entries: dict[tuple, tuple] = {}      # geometry -> (graph, its input buffer, its tree, its output)
+        self.pool = None                           # a pool handle while any graph is live, so captures share it
+
+    @staticmethod
+    def key(p: int, lengths) -> tuple:
+        return int(p), tuple(int(n) for n in lengths)
+
+    def cost(self, tokens: int) -> int:
+        """Bytes a graph for ``tokens`` packed tokens reserves: its forward's activations, its input and its output.
+
+        The pool a capture keeps is its forward's peak live set, which the per-token figure admission sizes (an
+        upper bound, not a measurement); the input and the rows of output are counted beside it.
+        """
+
+        c = self.model.cfg
+        return tokens * (packed_token_bytes(c.hidden, c.ffn, c.heads, c.head_dim) + 2 * BF16_BYTES * c.hidden)
+
+    @torch.no_grad()
+    def forward(self, p: int, lengths, x: torch.Tensor) -> torch.Tensor | None:
+        """The graphed rows for this geometry, or ``None`` to run the eager path (a new shape, or no room).
+
+        ``x`` is the packed embeddings the eager path built: they are copied into the graph's own input before it
+        replays, so no replay can read an earlier request's tokens or features. The rows come back as a clone, so a
+        caller's tensor can never be overwritten by a later replay.
+        """
+
+        key = self.key(p, lengths)
+        entry = self.entries.get(key)
+        if entry is None:
+            entry = self._promote(key, p, lengths, x)
+            if entry is None:
+                return None
+        graph, buf, _tree, out = entry
+        if buf.shape != x.shape:                   # a key that no longer names its own shape is a programming error
+            raise RuntimeError(f"a {tuple(buf.shape)} graph cannot take a {tuple(x.shape)} forward")
+        buf.copy_(x)
+        graph.replay()
+        self.roster.replay(key)
+        return out.clone()                         # the caller's rows, not the graph's buffer: a later replay is safe
+
+    @torch.no_grad()
+    def _promote(self, key: tuple, p: int, lengths, x: torch.Tensor) -> tuple | None:
+        """Capture this geometry's forward if it is hot enough and can have room; else ``None`` (the eager path)."""
+
+        cost = self.cost(x.shape[0])
+        heat = self.roster.note(key)
+        room = self.roster.room_for(cost, heat) if self.roster.wanted(key) and self.roster.fits(cost) else None
+        if room is None:
+            self.roster.eager += 1
+            return None
+        self._forget(room)
+        if self.pool is None:
+            self.pool = torch.cuda.graph_pool_handle()
+        device, cfg = self.model.embed.device, self.model.cfg
+        buf = torch.empty_like(x)                  # the graph's own input, never reallocated: the capture points at it
+        buf.copy_(x)
+        tree = Tree(p, list(lengths), device, cfg.taps)
+        torch.cuda.synchronize()
+        stream = torch.cuda.Stream()
+        stream.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(stream):            # compile the kernels and settle cuBLAS' plans outside the capture
+            self.model.forward(buf, tree)
+            self.model.forward(buf, tree)
+        torch.cuda.current_stream().wait_stream(stream)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        enabled = gc.isenabled()
+        gc.disable()                               # collecting a graph mid-capture invalidates it
+        try:
+            with torch.cuda.graph(graph, pool=self.pool):
+                out = self.model.forward(buf, tree)
+        finally:
+            if enabled:
+                gc.enable()
+        torch.cuda.synchronize()
+        self.entries[key] = (graph, buf, tree, out)
+        self.roster.admit(key, cost)               # only a captured geometry is recorded, so a failed one stays eager
+        self.roster.captures += 1
+        return self.entries[key]
+
+    def _forget(self, keys: list[tuple]) -> None:
+        """Drop evicted geometries; a pool left without a graph cannot be captured into again."""
+
+        if not keys:
+            return
+        for key in keys:
+            self.entries.pop(key, None)
+            self.roster.drop(key)
+        torch.cuda.synchronize()
+        gc.collect()                               # a destroyed graph must be gone before the next capture
+        if not self.entries:
+            self.pool = None
+
+    def stats(self) -> dict:
+        return self.roster.stats()
