@@ -0,0 +1,103 @@
+"""LFM2-VL pictures: the checkpoint's SigLIP2 NaFlex tower and projector (transformers' modules, bf16), and the
+processor that tiles a picture and writes its placeholder tokens. A picture's features replace its placeholder
+tokens' embeddings in the trunk; everything after that is the language model's tree forward."""
+
+from __future__ import annotations
+
+import json
+import math
+from pathlib import Path
+
+import torch
+
+MAX_PIXELS = 1024 * 1024           # every picture is bounded at this many pixels first (bicubic)
+
+
+def _cap(image):
+    w, h = image.size
+    if w * h <= MAX_PIXELS:
+        return image
+    from PIL import Image
+
+    s = math.sqrt(MAX_PIXELS / (w * h))
+    return image.resize((max(1, int(w * s)), max(1, int(h * s))), Image.Resampling.BICUBIC)
+
+
+class Vision:
+    def __init__(self, processor, tower, projector, image_token: int, device: str):
+        self.processor, self.tower, self.projector = processor, tower, projector
+        self.image_token, self.device = image_token, device
+        self._markup: dict[int, str] = {}
+
+    @classmethod
+    def load(cls, model_dir: Path, device: str = "cuda") -> "Vision":
+        from safetensors import safe_open
+        from transformers import AutoProcessor, Lfm2VlConfig
+        from transformers.models.lfm2_vl.modeling_lfm2_vl import Lfm2VlMultiModalProjector
+        from transformers.models.siglip2.modeling_siglip2 import Siglip2VisionModel
+
+        raw = json.loads((model_dir / "config.json").read_text())
+        if "vision_config" not in raw:
+            raise FileNotFoundError("no vision tower in this checkpoint")
+        cfg = Lfm2VlConfig(**{k: v for k, v in raw.items() if k not in ("auto_map", "architectures")})
+        tower = Siglip2VisionModel(cfg.vision_config).to(torch.bfloat16)
+        projector = Lfm2VlMultiModalProjector(cfg).to(torch.bfloat16)
+        state_t, state_p = {}, {}
+        for path in sorted(model_dir.glob("*.safetensors")):
+            with safe_open(str(path), "pt", device="cpu") as f:
+                for key in f.keys():
+                    if key.startswith("model.vision_tower."):
+                        state_t[key[len("model.vision_tower."):]] = f.get_tensor(key)
+                    elif key.startswith("model.multi_modal_projector."):
+                        state_p[key[len("model.multi_modal_projector."):]] = f.get_tensor(key)
+        wanted = set(tower.state_dict())
+        if not any(k in wanted for k in state_t):          # transformers releases differ in the wrapper prefix
+            state_t = {k.split("vision_model.", 1)[-1] if k.startswith("vision_model.") else f"vision_model.{k}": v
+                       for k, v in state_t.items()}
+        missing = tower.load_state_dict(state_t, strict=False)
+        if missing.missing_keys:
+            raise ValueError(f"vision tower weights missing: {missing.missing_keys[:4]}")
+        projector.load_state_dict(state_p)
+        tower.to(device).eval()
+        projector.to(device).eval()
+        processor = AutoProcessor.from_pretrained(str(model_dir))
+        return cls(processor, tower, projector, int(cfg.image_token_id), device)
+
+    def markup(self, n: int) -> str:
+        """What the chat template writes for ``n`` pictures at the head of a user turn."""
+
+        if n not in self._markup:
+            msgs = [{"role": "user", "content": [*([{"type": "image"}] * n), {"type": "text", "text": "\x00"}]}]
+            text = self.processor.apply_chat_template(msgs, add_generation_prompt=False, tokenize=False)
+            head = "<|im_start|>user\n"
+            self._markup[n] = text[text.index(head) + len(head):text.index("\x00")]
+        return self._markup[n]
+
+    @torch.inference_mode()
+    def trunk(self, model, fmt, state, images, suffix: str = "") -> tuple[list[int], torch.Tensor]:
+        """Token ids of the prefix (and ``suffix``, when given) with the pictures expanded, and their embeddings
+        with the pictures' features in their placeholder slots."""
+
+        pics = [_cap(im) for im in images]
+        text = fmt.prefix(state, self.markup(len(pics))) + suffix
+        inputs = self.processor(text=[text], images=[pics], return_tensors="pt", add_special_tokens=False)
+        ids = inputs["input_ids"][0]
+        pv, mask = inputs["pixel_values"], inputs["pixel_attention_mask"]
+        n = int(mask.sum(1).max())           # every picture is padded to the patch budget; the tower masks it
+        pv, mask = pv[:, :n], mask[:, :n]
+        out = self.tower(pixel_values=pv.to(self.device, torch.bfloat16), spatial_shapes=inputs["spatial_shapes"].to(self.device),
+                         pixel_attention_mask=mask.to(self.device), return_dict=True).last_hidden_state
+        lengths = mask.sum(dim=1)
+        feats = []
+        for i in range(out.shape[0]):
+            h, w = (int(v) for v in inputs["spatial_shapes"][i])
+            f = out[i, : int(lengths[i])].reshape(1, h, w, -1)
+            feats.append(self.projector(f).reshape(-1, self.projector.linear_2.out_features))
+        features = torch.cat(feats).to(torch.bfloat16)
+        ids_dev = ids.to(model.embed.device)
+        embeds = model.embed[ids_dev].clone()
+        slots = ids_dev == self.image_token
+        if int(slots.sum()) != features.shape[0]:
+            raise ValueError(f"{int(slots.sum())} picture slots for {features.shape[0]} picture features")
+        embeds[slots] = features
+        return ids.tolist(), embeds
