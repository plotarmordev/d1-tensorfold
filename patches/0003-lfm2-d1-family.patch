@@ -0,0 +1,40 @@
+"""LFM2 hybrids (short convolutions + GQA attention) on CUDA, served as decision models.
+
+Liquid AI's d1 checkpoints (``lfm2_vl``, e.g. d1-3B) answer typed questions about a state in one forward with
+zero output tokens: ``POST /v1/systemone`` takes ``{"state", "questions", "images"?}`` and returns the answers
+(the same request and response as llama.cpp's llama-server). TensorFold's ``/v1/decisions`` is served too.
+Generation is not: d1 is not a chat model.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+MODEL_TYPES = ("lfm2_vl", "lfm2")
+TITLE = "LFM2 (d1 decision models)"
+LANES = False
+MODELS = ("LiquidAI/d1-3B",)
+QUANT_METHODS = {"cuda": (None,)}        # the bf16 checkpoint; quantized copies are made from it at load
+
+
+def cuda_engine(model_dir: str | Path, **options: Any):
+    """The decision engine. ``TENSORFOLD_LFM2_PRECISION``: bf16 (default), fp8 or int4 weights;
+    ``TENSORFOLD_LFM2_TOKEN_BUDGET``: tokens packed into one forward; ``TENSORFOLD_LFM2_GRAPHS=0``: no CUDA graphs."""
+
+    import os
+
+    from .cuda.engine import Engine
+
+    precision = os.environ.get("TENSORFOLD_LFM2_PRECISION", "bf16").strip().lower()
+    budget = int(os.environ.get("TENSORFOLD_LFM2_TOKEN_BUDGET", "65536"))
+    graphs = os.environ.get("TENSORFOLD_LFM2_GRAPHS", "1") != "0"
+    return Engine(model_dir, precision=precision, token_budget=budget, graphs=graphs)
+
+
+def __getattr__(name: str):
+    if name == "CUDA_APP":             # imported on first use, so the Mac side never loads the CUDA server
+        from .cuda.app import DecisionApp
+
+        return DecisionApp
+    raise AttributeError(name)
