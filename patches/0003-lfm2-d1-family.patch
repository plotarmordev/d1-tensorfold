diff --git a/tensorfold/families/lfm2/cuda/app.py b/tensorfold/families/lfm2/cuda/app.py
--- /dev/null
+++ b/tensorfold/families/lfm2/cuda/app.py
@@ -0,0 +1,78 @@
+"""HTTP side of the LFM2 decision engine: ``/v1/systemone`` (llama-server's request and response) and
+TensorFold's ``/v1/decisions``; chat and completions answer that d1 does not write text."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from tensorfold.cuda.server import App, RequestError
+from tensorfold.vision.images import ImageInputError, load_images, split_images
+
+from ..decisions import DecisionError
+
+_MEDIA = ("input_audio", "audio", "video_url", "video")
+
+
+class DecisionApp(App):
+    """``/v1/systemone``: named questions over a state and its pictures, answered in one forward each."""
+
+    def _pictures(self, body: dict[str, Any]) -> tuple[Any, list]:
+        """The state (with its pictures taken out, as llama-server reads a System One state) and the pictures.
+
+        ``files`` and ``images`` hold data URLs; a chat-style state holds ``image_url`` content parts. Everything
+        else in the state stays as it was written, so the rendered decision is the same as llama-server's.
+        """
+
+        state = body["state"]
+        for key in ("files", "images"):
+            if body.get(key) is not None and not isinstance(body[key], list):
+                raise DecisionError(f"{key} must be an array of data URLs")
+        if body.get("videos"):
+            raise DecisionError("videos are not supported")
+        urls = [url for url in list(body.get("files") or []) + list(body.get("images") or [])]
+        messages = state.get("messages") if isinstance(state, dict) else state
+        if isinstance(messages, list) and messages:
+            kept = []
+            for message in messages:
+                content = message.get("content") if isinstance(message, dict) else None
+                if not isinstance(content, list):
+                    kept.append(message)
+                    continue
+                parts = []
+                for part in content:
+                    kind = part.get("type") if isinstance(part, dict) else None
+                    if kind == "image_url":
+                        url = part.get("image_url")
+                        urls.append(url.get("url") if isinstance(url, dict) else url)
+                    elif kind in _MEDIA:
+                        raise DecisionError(f"{kind} is not supported: a decision state takes images")
+                    else:
+                        parts.append(part)
+                kept.append({**message, "content": parts})
+            if isinstance(state, dict):
+                state = {**state, "messages": kept}
+            else:
+                state = kept
+            body["state"] = state
+        if not urls:
+            return state, []
+        if len(urls) > self.image_limits.max_images:
+            raise DecisionError(f"at most {self.image_limits.max_images} pictures a request")
+        try:
+            _, sources = split_images([{"role": "user", "content": [
+                {"type": "image_url", "image_url": {"url": url}} for url in urls]}], limits=self.image_limits)
+            return state, [image.to_pil() for image in load_images(sources, limits=self.image_limits)]
+        except ImageInputError as exc:
+            raise DecisionError(str(exc)) from exc
+
+    def systemone(self, body: dict[str, Any]) -> dict[str, Any]:
+        if "state" not in body:
+            raise DecisionError("a request needs a state (null when the question is the whole state)")
+        if "questions" not in body:
+            raise DecisionError("a request needs questions")
+        state, images = self._pictures(body)
+        out = self.engine.decide(state, body["questions"], images)
+        return {"model": self.served, **out}
+
+    def prepare(self, body, chat):  # noqa: D401 - App's signature
+        raise RequestError("d1 is a decision model and does not write text: use POST /v1/systemone")
diff --git a/tensorfold/families/lfm2/cuda/engine.py b/tensorfold/families/lfm2/cuda/engine.py
--- /dev/null
+++ b/tensorfold/families/lfm2/cuda/engine.py
@@ -0,0 +1,184 @@
+"""The LFM2 decision engine: a state and its questions in, typed answers out, one forward a request.
+
+A request reads its state once (the trunk) and each of its questions as a branch, packed back to back on one
+axis, so many questions cost about one forward. Requests are serialized and never
+share a forward: a packed batch would change each row's arithmetic (cuBLAS picks another kernel for another row
+count), so a decision's answer depends on the request alone and a request answered alone and beside others reads
+the same bits. One forward reads at most ``token_budget`` tokens; a request whose questions do not fit continues
+in the next forward. A tree geometry that has been asked for twice is captured as an exact-shape CUDA graph and
+replayed from then on (``graphs=False`` keeps every forward eager); a new, first or long geometry runs the eager
+path, whose shapes the graph replays unchanged.
+"""
+
+from __future__ import annotations
+
+import threading
+import time
+from pathlib import Path
+from typing import Any
+
+import torch
+
+from ..decisions import DecisionError, Format, Question, answer, question
+from .graphs import BUDGET, Graphs
+from .model import Model, Tree, packed_token_bytes
+
+
+def forward_geometry(t: dict, graphs: bool = True) -> "Geometry":
+    """The startup estimate's activation geometry: bytes a decision's forward holds per packed token.
+
+    The graphs' bounded pools are reserved beside it (the budget the graph cache keeps its captures inside), so a
+    --context that cannot fit the weights and both is refused before any weight is loaded.
+    """
+
+    from tensorfold.cuda.capacity import Geometry
+
+    d = int(t["hidden_size"])
+    ffn = int(t["intermediate_size"])
+    heads = int(t["num_attention_heads"])
+    head_dim = int(t.get("head_dim") or d // heads)
+    per_token = packed_token_bytes(d, ffn, heads, head_dim)
+    # the graph budget in cache slots: what the retained graphs may hold, charged to the window's own workspace
+    reserve = -(-BUDGET // per_token) if graphs else 0
+    return Geometry(bytes_at=lambda slots: slots * per_token, reserve=reserve, minimum_slots=1)
+
+
+def weight_bytes(name: str, info: dict) -> tuple[int, int]:
+    """Every checkpoint tensor is read as it is stored: bf16 language weights and the vision tower."""
+
+    from tensorfold.cuda.geometry import size
+
+    return size(info, name), 0
+
+
+class Engine:
+    eos: tuple[int, ...] = ()
+    supports_logprobs = False
+
+    def __init__(self, model_dir: str | Path, context: int | None = None, context_explicit: bool | None = None,
+                 token_budget: int = 65536, graphs: bool = True):
+        from tokenizers import Tokenizer
+
+        from tensorfold.cuda.capacity import admit
+
+        self.model_dir = Path(model_dir)
+        self.served = 0
+        self._gpu_lock = threading.Lock()
+        if int(token_budget) < 1:
+            raise ValueError("token_budget must be positive")
+        self.graphs_on = bool(graphs)
+        torch.cuda.set_device(0)
+        # one admission for the weights, a decision's activations and the graphs' pools, before any weight is loaded
+        self.capacity_plan = admit(self.model_dir, context, context_explicit, torch,
+                                   lambda t: forward_geometry(t, self.graphs_on), weight_bytes)
+        self.context = self.context_window = int(self.capacity_plan["context_window"])
+        self.token_budget = min(int(token_budget), self.context)
+        started = time.perf_counter()
+        self.model = Model.load(self.model_dir)
+        self.graphs = Graphs(self.model) if self.graphs_on else None
+        self.vision = None
+        if self.model.cfg.vision:
+            from .vision import Vision
+
+            self.vision = Vision.load(self.model_dir)
+        self.fmt = Format(Tokenizer.from_file(str(self.model_dir / "tokenizer.json")))
+        self.load_s = time.perf_counter() - started
+
+    # ---------------------------------------------------------------- api
+
+    def decide(self, state: Any, questions: dict[str, Any], images: list | None = None) -> dict[str, Any]:
+        """The answers to a request's questions; the state and the questions' own tokens are all it reads."""
+
+        if not isinstance(questions, dict) or not questions:
+            raise DecisionError("questions is a non-empty object of id: question")
+        named = [(str(name), question(raw)) for name, raw in questions.items()]
+        if images and self.vision is None:
+            raise DecisionError("this checkpoint has no vision tower")
+        with self._gpu_lock:
+            answers, read = self._answer(state, named, list(images or []))
+        self.served += 1
+        return {"answers": answers, "usage": {"input_tokens": read, "output_tokens": 0}}
+
+    def generate(self, *_, **__):
+        raise DecisionError("d1 is a decision model and does not write text: use POST /v1/systemone")
+
+    @torch.inference_mode()
+    def score_labels(self, prompt_ids, label_ids) -> tuple[list[float], float]:
+        """Generic /v1/decisions needs full-vocabulary mass; System One uses the sparse head instead."""
+
+        ids = list(prompt_ids)
+        if not ids:
+            raise DecisionError("a decision prompt cannot be empty")
+        with self._gpu_lock:
+            hidden = self._forward(ids[:-1], [ids[-1:]])
+            logits = torch.nn.functional.linear(hidden, self.model.embed).float()[0]
+            return logits[list(label_ids)].tolist(), float(logits.logsumexp(0))
+
+    # ---------------------------------------------------------------- forwards
+
+    def _answer(self, state: Any, named: list[tuple[str, Question]], images: list) -> tuple[dict, int]:
+        """One trunk, one branch a question, as many questions a forward as the token budget holds."""
+
+        f = self.fmt
+        embeds = None
+        if images:
+            trunk, embeds = self.vision.trunk(self.model, f, state, images)
+        else:
+            trunk = f.encode(f.prefix(state))
+        branches = [f.encode(f.suffix(q)) for _, q in named]
+        groups = [f.readout(q) for _, q in named]
+        answers: dict[str, Any] = {}
+        start = 0
+        while start < len(branches):
+            end = self._chunk(branches, start, len(trunk))
+            hidden = self._forward(trunk, branches[start:end], embeds)
+            for (name, q), scores in zip(named[start:end], self._scores(hidden, groups[start:end])):
+                answers[name] = answer(q, scores)
+            start = end
+        return answers, len(trunk) + sum(map(len, branches))
+
+    def _chunk(self, branches: list[list[int]], start: int, trunk: int) -> int:
+        """Where the forward starting at ``start`` ends: the questions whose tokens fit the budget with the trunk,
+        and always at least one (a question that does not fit is refused by ``_check_size``)."""
+
+        end, used = start, trunk + len(branches[start])
+        while end + 1 < len(branches) and used + len(branches[end + 1]) <= self.token_budget:
+            used += len(branches[end + 1])
+            end += 1
+        return end + 1
+
+    def _check_size(self, trunk: int, lengths: list[int]) -> None:
+        if not lengths or min(lengths) <= 0:
+            raise DecisionError("each question needs a nonempty token sequence")
+        if trunk + max(lengths) > self.context:
+            raise DecisionError(f"a decision sequence exceeds the {self.context}-token context")
+        if trunk + sum(lengths) > self.token_budget:
+            raise DecisionError(f"a forward exceeds the {self.token_budget}-token budget")
+
+    def _forward(self, trunk: list[int], rows: list[list[int]], embeds: torch.Tensor | None = None) -> torch.Tensor:
+        self._check_size(len(trunk), [len(row) for row in rows])
+        dev = self.model.embed.device
+        ids = torch.tensor(trunk + [t for r in rows for t in r], device=dev)
+        x = self.model.embed[ids]
+        if embeds is not None:                       # pictures: their features replace the trunk's image slots
+            x[: len(trunk)] = embeds
+        if self.graphs is not None:
+            # the graph copies the whole of x, pictures included, into its own input before replaying: a replay
+            # can never read an earlier request's tokens or features
+            out = self.graphs.forward(len(trunk), [len(r) for r in rows], x)
+            if out is not None:                      # this geometry replays: the eager path's own bits, its own shapes
+                return out
+        tree = Tree(len(trunk), [len(r) for r in rows], dev, self.model.cfg.taps)
+        return self.model.forward(x, tree)
+
+    def _scores(self, hidden: torch.Tensor, groups: list[list[list[int]]]) -> list[list[float]]:
+        """Each row's best logit an option, read with that question's own tokens only: the option set of another
+        question (or another request) never changes a row's logits or how many rows the head multiplies."""
+
+        out = []
+        for row, group in zip(hidden, groups):
+            ids = sorted({t for g in group for t in g})
+            logits = self.model.logits(row[None], torch.tensor(ids, device=hidden.device))[0]
+            where = {t: i for i, t in enumerate(ids)}
+            out.append([float(max(logits[where[t]] for t in g)) for g in group])
+        return out
diff --git a/tensorfold/families/lfm2/cuda/fused.py b/tensorfold/families/lfm2/cuda/fused.py
--- /dev/null
+++ b/tensorfold/families/lfm2/cuda/fused.py
@@ -0,0 +1,133 @@
+"""Fused LFM2 glue: each kernel reads its inputs once and rounds to bf16 where the eager torch code does.
+
+``add_rms``       h + y (bf16), then RMSNorm in fp32 rounded to bf16, times the weight in bf16.
+``silu_mul``      silu(gate) rounded to bf16, times up, from the merged [gate | up] projection.
+``short_conv``    B*x, the causal depthwise conv over each token's predecessors (a table, so a branch continues its
+                  trunk), times C, read straight from the in_proj output: no transposes, gathers or copies.
+``qk_norm_rope``  per-head q/k RMSNorm then half-split RoPE, from the merged q|k|v projection.
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _add_rms(H, Y, W, HO, XO, eps, N: tl.constexpr, ADD: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    cols = tl.arange(0, N)
+    h = tl.load(H + row * N + cols)
+    if ADD:
+        h = (h.to(tl.float32) + tl.load(Y + row * N + cols).to(tl.float32)).to(tl.bfloat16)
+        tl.store(HO + row * N + cols, h)
+    x = h.to(tl.float32)
+    r = 1.0 / tl.sqrt(tl.sum(x * x, 0) / N + eps)
+    xn = (x * r).to(tl.bfloat16).to(tl.float32)
+    w = tl.load(W + cols).to(tl.float32)
+    tl.store(XO + row * N + cols, (xn * w).to(tl.bfloat16))
+
+
+def add_rms(h: torch.Tensor, y: torch.Tensor | None, w: torch.Tensor, eps: float):
+    """``(h + y, rms(h + y) * w)``, or ``(h, rms(h) * w)`` with no ``y``."""
+
+    t, n = h.shape
+    x = torch.empty_like(h)
+    hout = torch.empty_like(h) if y is not None else h
+    if t:
+        _add_rms[(t,)](h, y if y is not None else h, w, hout, x, eps, N=n, ADD=y is not None, num_warps=8,
+                       enable_fp_fusion=False)
+    return hout, x
+
+
+@triton.jit
+def _silu_mul(X, O, F: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    cols = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    m = cols < F
+    g = tl.load(X + row * 2 * F + cols, mask=m).to(tl.float32)
+    u = tl.load(X + row * 2 * F + F + cols, mask=m).to(tl.float32)
+    s = (g / (1.0 + tl.exp(-g))).to(tl.bfloat16).to(tl.float32)
+    tl.store(O + row * F + cols, (s * u).to(tl.bfloat16), mask=m)
+
+
+def silu_mul(x: torch.Tensor) -> torch.Tensor:
+    t, f2 = x.shape
+    f = f2 // 2
+    out = torch.empty((t, f), dtype=x.dtype, device=x.device)
+    if t:
+        _silu_mul[(t, triton.cdiv(f, 1024))](x, out, F=f, BLOCK=1024, num_warps=4, enable_fp_fusion=False)
+    return out
+
+
+@triton.jit
+def _short_conv(P, Wc, PREV, O, C: tl.constexpr, TAPS: tl.constexpr, BLOCK: tl.constexpr):
+    t = tl.program_id(0).to(tl.int64)
+    c = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    m = c < C
+    acc = tl.zeros((BLOCK,), dtype=tl.float32)
+    for j in tl.static_range(TAPS - 1):          # the oldest tap first, as the conv sums them
+        back = TAPS - 1 - j
+        src = tl.load(PREV + t * (TAPS - 1) + back - 1).to(tl.int64)
+        ok = m & (src >= 0)
+        b = tl.load(P + src * 3 * C + c, mask=ok, other=0.0).to(tl.float32)
+        x = tl.load(P + src * 3 * C + 2 * C + c, mask=ok, other=0.0).to(tl.float32)
+        acc += tl.load(Wc + c * TAPS + j, mask=m, other=0.0).to(tl.float32) * (b * x).to(tl.bfloat16).to(tl.float32)
+    b = tl.load(P + t * 3 * C + c, mask=m).to(tl.float32)
+    x = tl.load(P + t * 3 * C + 2 * C + c, mask=m).to(tl.float32)
+    acc += tl.load(Wc + c * TAPS + TAPS - 1, mask=m).to(tl.float32) * (b * x).to(tl.bfloat16).to(tl.float32)
+    gate = tl.load(P + t * 3 * C + C + c, mask=m).to(tl.float32)
+    tl.store(O + t * C + c, (gate * acc.to(tl.bfloat16).to(tl.float32)).to(tl.bfloat16), mask=m)
+
+
+def short_conv(proj: torch.Tensor, weight: torch.Tensor, prev: torch.Tensor) -> torch.Tensor:
+    """``proj`` [T, 3C] (B | C | x), ``weight`` (C, 1, taps), ``prev`` [T, taps-1] int64 (-1: zero padding) -> [T, C]."""
+
+    t, c3 = proj.shape
+    c = c3 // 3
+    out = torch.empty((t, c), dtype=proj.dtype, device=proj.device)
+    if t:
+        _short_conv[(t, triton.cdiv(c, 512))](proj, weight, prev, out, C=c, TAPS=weight.shape[-1], BLOCK=512,
+                                              num_warps=4, enable_fp_fusion=False)
+    return out
+
+
+@triton.jit
+def _qk_norm_rope(QKV, QW, KW, COS, SIN, QO, KO, eps, H: tl.constexpr, KV: tl.constexpr, D: tl.constexpr):
+    t = tl.program_id(0).to(tl.int64)
+    h = tl.program_id(1)
+    d = tl.arange(0, D)
+    half: tl.constexpr = D // 2
+    rot = tl.where(d < half, d + half, d - half)
+    sign = tl.where(d < half, -1.0, 1.0)
+    base = QKV + t * (H + 2 * KV) * D + h * D        # q heads, then k heads, side by side
+    x = tl.load(base + d).to(tl.float32)
+    r = 1.0 / tl.sqrt(tl.sum(x * x, 0) / D + eps)
+    xr = tl.load(base + rot).to(tl.float32)
+    if h < H:
+        w, wr = tl.load(QW + d).to(tl.float32), tl.load(QW + rot).to(tl.float32)
+    else:
+        w, wr = tl.load(KW + d).to(tl.float32), tl.load(KW + rot).to(tl.float32)
+    n = ((x * r).to(tl.bfloat16).to(tl.float32) * w).to(tl.bfloat16).to(tl.float32)
+    nr = ((xr * r).to(tl.bfloat16).to(tl.float32) * wr).to(tl.bfloat16).to(tl.float32)
+    cos = tl.load(COS + t * D + d)
+    sin = tl.load(SIN + t * D + d)
+    y = (n * cos + (sign * nr) * sin).to(tl.bfloat16)
+    if h < H:
+        tl.store(QO + (t * H + h) * D + d, y)
+    else:
+        tl.store(KO + (t * KV + h - H) * D + d, y)
+
+
+def qk_norm_rope(qkv: torch.Tensor, q_w: torch.Tensor, k_w: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor,
+                 heads: int, kv_heads: int, head_dim: int, eps: float):
+    """``qkv`` [T, (H + 2 KV) D] -> q (T, H, D), k (T, KV, D), both normed and rotated; ``cos``/``sin`` fp32 [T, D]."""
+
+    t = qkv.shape[0]
+    q = torch.empty((t, heads, head_dim), dtype=qkv.dtype, device=qkv.device)
+    k = torch.empty((t, kv_heads, head_dim), dtype=qkv.dtype, device=qkv.device)
+    if t:
+        _qk_norm_rope[(t, heads + kv_heads)](qkv, q_w, k_w, cos, sin, q, k, eps, H=heads, KV=kv_heads, D=head_dim,
+                                             num_warps=1, enable_fp_fusion=False)
+    return q, k
