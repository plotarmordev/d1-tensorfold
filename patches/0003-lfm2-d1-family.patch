@@ -0,0 +1,60 @@
+"""HTTP side of the LFM2 decision engine: ``/v1/systemone`` (llama-server's request and response) and
+TensorFold's ``/v1/decisions``; chat and completions answer that d1 does not write text."""
+
+from __future__ import annotations
+
+import base64
+import io
+from typing import Any
+
+from tensorfold.cuda.server import App, RequestError
+
+from ..decisions import DecisionError
+
+MAX_IMAGES = 8
+
+
+def _images(body: dict[str, Any]) -> list:
+    """Data-URL pictures from ``files``/``images`` and from chat-style ``image_url`` parts of the state."""
+
+    urls = list(body.get("files") or []) + list(body.get("images") or [])
+    state = body.get("state")
+    messages = state.get("messages") if isinstance(state, dict) else state if isinstance(state, list) else None
+    if isinstance(messages, list):
+        for m in messages:
+            content = m.get("content") if isinstance(m, dict) else None
+            if isinstance(content, list):
+                keep = []
+                for part in content:
+                    if isinstance(part, dict) and part.get("type") == "image_url":
+                        url = part.get("image_url")
+                        urls.append(url.get("url") if isinstance(url, dict) else url)
+                    else:
+                        keep.append(part)
+                m["content"] = keep
+    if len(urls) > MAX_IMAGES:
+        raise DecisionError(f"at most {MAX_IMAGES} pictures a request")
+    out = []
+    for url in urls:
+        if not isinstance(url, str) or not url.startswith("data:image/") or "," not in url:
+            raise DecisionError("pictures are data URLs (data:image/...;base64,...)")
+        from PIL import Image
+
+        out.append(Image.open(io.BytesIO(base64.b64decode(url.split(",", 1)[1]))).convert("RGB"))
+    return out
+
+
+class DecisionApp(App):
+    def systemone(self, body: dict[str, Any]) -> dict[str, Any]:
+        if "state" not in body:
+            raise DecisionError("a request needs a state (null when the pictures are the whole state)")
+        if "questions" not in body:
+            raise DecisionError("a request needs questions")
+        images = _images(body)
+        if body["state"] is None and not images:
+            raise DecisionError("a null state needs at least one picture")
+        out = self.engine.decide(body["state"], body["questions"], images)
+        return {"model": self.served, **out}
+
+    def prepare(self, body, chat):  # noqa: D401 - App's signature
+        raise RequestError("d1 is a decision model and does not write text: use POST /v1/systemone")
diff --git a/tensorfold/families/lfm2/cuda/engine.py b/tensorfold/families/lfm2/cuda/engine.py
