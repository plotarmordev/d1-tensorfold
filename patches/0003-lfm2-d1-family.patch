diff --git a/tensorfold/families/lfm2/__init__.py b/tensorfold/families/lfm2/__init__.py
--- /dev/null
+++ b/tensorfold/families/lfm2/__init__.py
@@ -0,0 +1,111 @@
+"""LFM2-VL decision models on CUDA (Liquid AI's d1).
+
+A d1 checkpoint answers typed questions about a state in one forward with zero output tokens: ``POST
+/v1/systemone`` takes ``{"state", "questions", "images"?}`` and returns the answers (llama-server's System One
+request and response); TensorFold's ``/v1/decisions`` is served too. Generation is not: d1 is not a chat model.
+Only ``LiquidAI/d1-3B`` is tested, so only its ``lfm2_vl`` checkpoints are served: the text-only ``lfm2``
+checkpoints answer decisions with the same prompt format but are not qualified here.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+MODEL_TYPES = ("lfm2_vl",)
+TITLE = "LFM2-VL (d1 decision model)"
+LANES = False        # there is no decoding: a decision is one forward a request, not lane rounds of a verify window
+MODELS = ("LiquidAI/d1-3B",)
+QUANT_METHODS = {"cuda": (None,)}     # the checkpoint's own bf16 weights; no quantized copy is made at load
+# tokens one forward may read (TENSORFOLD_LFM2_TOKEN_BUDGET tightens it, the admitted context caps it)
+TOKEN_BUDGET = 65536
+# TENSORFOLD_LFM2_GRAPHS: exact-shape CUDA graphs on (unset, the default) or off, for an eager comparison
+GRAPH_FLAGS = {"1": True, "on": True, "true": True, "yes": True, "0": False, "off": False, "false": False, "no": False}
+
+
+def read_text_config(model_dir: str | Path) -> tuple[dict[str, Any], dict[str, Any]]:
+    """The checkpoint's config and its text config, refused from JSON alone when the kernels do not read it."""
+
+    from tensorfold.families import OWN_MODEL_HELP, describe_quantization, quant_method, read_config
+
+    config = read_config(model_dir)
+    if quant_method(config) is not None:
+        raise ValueError(f"LFM2 d1 runs the checkpoint's own bf16 weights ({MODELS[0]}) and quantizes nothing at "
+                         f"load; this checkpoint stores {describe_quantization(config)}. Serve the bf16 checkpoint "
+                         f"it ships. {OWN_MODEL_HELP}")
+    text = config.get("text_config") if isinstance(config.get("text_config"), dict) else config
+    heads = int(text.get("num_attention_heads") or 0)
+    kinds = {str(kind) for kind in (text.get("layer_types") or ())}
+    bad = [what for what, ok in (
+        ("a dtype other than bfloat16", str(text.get("dtype") or config.get("dtype") or "bfloat16") != "bfloat16"),
+        ("no layer_types", not kinds),
+        ("a layer that is neither conv nor full_attention", bool(kinds - {"conv", "full_attention"})),
+        ("a convolution bias", bool(text.get("conv_bias"))),
+        ("an attention bias", bool(text.get("attention_bias"))),
+        ("no SwiGLU block", text.get("block_use_swiglu") is False),
+        ("no short convolution (conv_L_cache)", int(text.get("conv_L_cache") or 0) < 1),
+        ("no grouped attention", int(text.get("num_key_value_heads") or 0) < 1 or int(text.get("num_key_value_heads"))
+         > heads),
+        ("a hidden size that is not a whole number of heads",
+         not heads or int(text.get("hidden_size") or 0) % heads),
+        ("no vocabulary", int(text.get("vocab_size") or 0) < 1),
+        ("no MLP width (intermediate_size)", int(text.get("intermediate_size") or 0) < 1),
+        ("no normalization epsilon", not (text.get("norm_eps") or text.get("block_norm_eps"))),
+    ) if ok]
+    if bad:
+        raise ValueError(f"TensorFold's LFM2 kernels cover Liquid AI's d1 decision checkpoints ({MODELS[0]}); this "
+                         f"one has {', '.join(bad)}. {OWN_MODEL_HELP}")
+    return config, text
+
+
+def check(model_dir: str | Path) -> None:
+    """Refuse a checkpoint the kernels do not read, from config.json alone (``pull``, ``info`` and ``serve``)."""
+
+    read_text_config(model_dir)
+
+
+def cuda_engine(model_dir: str | Path, *, drafter: str = "", tp: int = 1, rank: int = 0, master: str = "",
+                master_port: int = 29551, no_drafts: bool = False, context: int | None = None,
+                context_explicit: bool | None = None, **options: Any):
+    """The decision engine: one forward a request, up to ``TENSORFOLD_LFM2_TOKEN_BUDGET`` tokens a forward (65536 by
+    default), ``--context`` bounding a decision's own tokens. Drafts, several ranks and several streams do not
+    apply: a decision decodes nothing, so there is no window to verify together. A tree geometry seen twice is
+    captured as an exact-shape CUDA graph and replayed after that; ``TENSORFOLD_LFM2_GRAPHS=off`` keeps every
+    forward eager, and the graphs' bounded pools are reserved by the startup admission."""
+
+    import os
+
+    if int(tp) != 1 or int(rank) != 0:
+        raise ValueError("LFM2 d1 decisions run on one GPU with one rank: serve with --tp 1 --rank 0")
+    if master:
+        raise ValueError("LFM2 d1 has one rank: drop --master")
+    if drafter:
+        raise ValueError("LFM2 d1 decodes nothing, so there is nothing to draft: --drafter does not apply")
+    stale = os.environ.get("TENSORFOLD_LFM2_PRECISION", "").strip().lower()
+    if stale and stale != "bf16":
+        raise ValueError(f"TENSORFOLD_LFM2_PRECISION={stale}: this engine runs the checkpoint's own bf16 weights and "
+                         "makes no quantized copy at load; drop the variable")
+    asked = os.environ.get("TENSORFOLD_LFM2_GRAPHS", "").strip().lower()
+    if asked and asked not in GRAPH_FLAGS:
+        raise ValueError(f"TENSORFOLD_LFM2_GRAPHS={asked!r}: on/1 (the default: exact-shape CUDA graphs, one a tree "
+                         "geometry, replayed with the new embeddings) or off/0 (every forward eager); drop it")
+    budget = os.environ.get("TENSORFOLD_LFM2_TOKEN_BUDGET", "").strip()
+    if budget and (not budget.isdecimal() or int(budget) < 1):
+        raise ValueError(f"TENSORFOLD_LFM2_TOKEN_BUDGET={budget!r}: a positive token count")
+    if options:
+        raise ValueError(f"LFM2 d1 decisions take no {', '.join(sorted(options))}: they run one request a forward "
+                         "(no --parallel streams, no MTP drafts, no draft model)")
+    check(model_dir)
+    from .cuda.engine import Engine
+
+    return Engine(model_dir, context=context, context_explicit=context_explicit,
+                  token_budget=int(budget) if budget else TOKEN_BUDGET,
+                  graphs=GRAPH_FLAGS[asked] if asked else True)
+
+
+def __getattr__(name: str):
+    if name == "CUDA_APP":             # imported on first use, so the Mac side never loads the CUDA server
+        from .cuda.app import DecisionApp
+
+        return DecisionApp
+    raise AttributeError(name)
