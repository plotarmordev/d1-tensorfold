# Copy to scripts/local.sh (git-ignored) and keep only the lines you change. The environment still wins.

# CONTEXT=4096                     # 1–32768; performance and memory snapshots used 4096
# HOST=0.0.0.0                     # listen on every interface (the default is this machine only)
# PORT=8080
# DATA_DIR=/srv/d1                 # models and kernel caches
# CUDA_ARCH=120                    # the llama.cpp baseline's GPU: 121 GB10, 120 RTX 50, 89 RTX 40, 90 H100
